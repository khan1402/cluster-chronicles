# secrets.env.example - the secrets this project needs. NO real values here.
#
# Copy this file to secrets.env (ignored by Git), fill in the values,
# protect it, then create the Kubernetes Secrets from it:
#   cp security/secrets/secrets.env.example security/secrets/secrets.env
#   chmod 600 security/secrets/secrets.env
#   bash scripts/create-secrets.sh
#
# Wrap a value in single quotes if it contains spaces or special characters.

# Jenkins admin login (user "admin") - choose a strong password
JENKINS_ADMIN_PASSWORD=

# Gitea: Jenkins reads the repository with this.
# Gitea -> Settings -> Applications -> Generate New Token (repository: Read)
GITEA_USERNAME=zeeshankhan
GITEA_TOKEN=

# Docker Hub: Kaniko pushes the app images with this.
# Docker Hub -> Account settings -> Personal access tokens (Read & Write)
DOCKERHUB_USERNAME=zeek14
DOCKERHUB_TOKEN=

# Slack incoming webhook: pipeline results are posted here
SLACK_WEBHOOK_URL=

# Grafana admin login (user "admin") - choose a strong password
GRAFANA_ADMIN_PASSWORD=